{
  "name": "nutrilog",
  "version": "2.15.1",
  "description": "NutriLog — personal macro tracker (phone PWA, desktop web, Windows app)",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win --x64",
    "release": "npm run electron:build && node scripts/publish-release.mjs",
    "backup:cloud": "node scripts/backup-cloud.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "chart.js": "^4.5.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "heic-convert": "^2.1.0"
  },
  "build": {
    "appId": "com.apm.nutrilog",
    "productName": "NutriLog",
    "copyright": "Copyright © 2026 Alex · APm R&D",
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NutriLog"
    },
    "publish": {
      "provider": "github",
      "owner": "alxkim97",
      "repo": "nutrilog"
    }
  }
}
