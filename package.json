{
  "name": "nutrilog",
  "version": "2.13.1",
  "description": "NutriLog â€” personal macro tracker (phone PWA, desktop web, Windows app)",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backup:cloud": "node scripts/backup-cloud.mjs",
    "start": "electron .",
    "start:dev": "electron . --dev",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.apm.nutrilog",
    "productName": "NutriLog",
    "copyright": "Copyright Â© 2026 Alex Â· APm R&D",
    "files": [
      "main.js",
      "preload.js",
      "legacy/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NutriLog"
    },
    "publish": {
      "provider": "github",
      "owner": "alxkim97",
      "repo": "nutrilog"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "^6.8.9",
    "heic-convert": "^2.1.0"
  }
}
